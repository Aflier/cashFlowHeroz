<tr class="sm:hidden">
  <td class="py-1" colspan="5"><%= transaction.why %></td>
</tr>

<tr id="<%= dom_id transaction %>" class="border-b-2">
  <td class="py-1">
    <%= link_to transaction.transaction_at.strftime("%d %b"), transaction %>
  </td>
  <td class="hidden sm:table-cell">
    <%= transaction.why %>
  </td>
  <td class="text-right hidden sm:table-cell">
    <%= transaction.amount %>
  </td>
  <td class="text-right text-green-500">
    <% if transaction.in? %>
      <%= transaction.amount %>
    <% elsif transaction.correction? and transaction.amount > 0 %>
      <%= transaction.amount %>
    <% end %>
  </td>
  <td class="text-right text-red-500">
    <% if transaction.out? %>
      (<%= transaction.amount %>)
    <% elsif transaction.correction? and transaction.amount < 0 %>
      (<%= transaction.amount %>)
    <% end %>
  </td>

  <td
    class="text-right <%= 'bg-red-200' if (transaction.cumulative_total.nil? ? false : transaction.cumulative_total < 0) %>"
  ><%= transaction.cumulative_total %></td>
  <td class="hidden sm:table-cell">
    <%= transaction.business_account_balance %>
  </td>
  <td class="hidden sm:table-cell">
    <%= transaction.vatable? ? "Yes" : "No" unless transaction.vatable.nil? %>
  </td>
  <td class="hidden sm:table-cell">
    <%= transaction.vat if transaction.vatable? %>
  </td>
  <td class="text-right py-1 hidden sm:table-cell whitespace-nowrap">

    <%= unless transaction.xero_uuid or transaction.child
      button_to "+",
      duplicate_transaction_path(transaction),
      method: :patch,
      class: "btn-edit-sm"
    end %>

    <%= link_to icons__edit,
    edit_transaction_path(transaction),
    class: "btn-edit-sm",
    data: {
      turbo_frame: :remote_modal,
    } %>
    <%= button_to icons__trash,
    transaction_path(transaction),
    method: :delete,
    data: {
      turbo_confirm: "Are you sure?",
    },
    class: "btn-trash-sm" %>
  </td>
</tr>
