<% content_for :title, "Editing transaction" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing transaction</h1>
  <%= turbo_frame_tag :remote_modal, target: :_top do %>
    <%= form_with(model: @transaction, class: "contents") do |form| %>
      <%= render 'shared/modal', title: "Edit Transaction",
                 submit: form.submit(class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer",
                                     data: { turbo_frame: :_top }) do %>
        <%= render "form", transaction: @transaction, form: form %>
      <% end %>
    <% end %>
  <% end %>
  <%= link_to "Show this transaction", @transaction, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to transactions", transactions_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
