<%= form_with(model: [@mission, creditor], class: "contents") do |form| %>
  <% if creditor.errors.any? %>
    <div
      id="error_explanation"
      class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3"
    >
      <h2><%= pluralize(creditor.errors.count, "error") %>
        prohibited this creditor from being saved:</h2>

      <ul class="list-disc ml-6">
        <% creditor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:name].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:name].any?,
                      },
                    ] %>
  </div>

  <div class="my-5">
    <%= form.label :starting_balance %>
    <%= form.text_field :starting_balance,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:starting_balance].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:starting_balance].any?,
                      },
                    ] %>
  </div>

  <div class="my-5">
    <%= form.label :starting_balance_on %>
    <%= form.date_field :starting_balance_on,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:starting_balance_on].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:starting_balance_on].any?,
                      },
                    ] %>
  </div>

  <div class="my-5">
    <%= form.label :current_balance %>
    <%= form.text_field :current_balance,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:current_balance].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:current_balance].any?,
                      },
                    ] %>
  </div>

  <div class="my-5">
    <%= form.label :current_balance_on %>
    <%= form.date_field :current_balance_on,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:current_balance_on].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:current_balance_on].any?,
                      },
                    ] %>
  </div>

  <div class="my-5">
    <%= form.label :monthly_payment %>
    <%= form.text_field :monthly_payment,
                    class: [
                      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                      {
                        "border-gray-400 focus:outline-blue-600":
                          creditor.errors[:monthly_payment].none?,
                        "border-red-400 focus:outline-red-600":
                          creditor.errors[:monthly_payment].any?,
                      },
                    ] %>
  </div>

  <div class="inline">
    <%= form.submit class:
                  "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
