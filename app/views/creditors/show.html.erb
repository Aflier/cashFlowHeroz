<% content_for :title, "Showing creditor" %>

<% if notice.present? %>
  <p
    class="
      py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block
    "
    id="notice"
  ><%= notice %></p>
<% end %>

<%= link_to "Edit this creditor",
edit_creditor_path(@creditor),
class: "btn-edit float-right ml-1" %>
<%= link_to "Back to creditors",
mission_creditors_path(@creditor.mission),
class: "link-back" %>
<h1 class="font-bold text-4xl">Showing creditor</h1>

<%= render @creditor %>
<div class="input-group">
  <%= @creditor.notes %>
</div>
<%= button_to "Destroy this creditor",
@creditor,
method: :delete,
form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2",
class:
  "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer",
data: {
  turbo_confirm: "Are you sure?",
} %>
