<h1>Legal Entities</h1>

<table class="table table-sm">
  <thead>
  <tr>
    <th>Name</th>
  </tr>
  </thead>
  <tbody>
  <% @legal_entities.each do |legal_entity| %>
    <tr>
      <td><%= link_to_if (can? :show, legal_entity), legal_entity.name, legal_entity %></td>
    </tr>
  <% end %>
  </tbody>
</table>
