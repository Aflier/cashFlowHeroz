<% content_for :title, "Creditors" %>

<div class="w-full">

  <%= link_to "New creditor",
  new_mission_creditor_path(@mission),
  class: "btn-new float-right ml-1" %>
  <h1>Creditors</h1>

  <div id="creditors" class="min-w-full divide-y space-y-5">
    <% if @creditors.any? %>
      <table>
        <tr>
          <td>
            <strong class="block font-medium mb-1">Name:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Starting balance:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Starting balance on:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Current balance:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Current balance on:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Monthly payment:</strong>
          </td>
          <td class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
          </td>
        </tr>
        <%= render @creditors %>
      </table>
    <% else %>
      <p class="text-center my-10">No creditors found.</p>
    <% end %>
  </div>
</div>
