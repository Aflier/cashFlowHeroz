<h1><%= @mission.name %></h1>
<h2>Users</h2>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th class="text-right">Role</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="mission_users">
    <%= render @mission.mission_users %>
  </tbody>
</table>

<%= turbo_frame_tag :new_mission_user, loading: :lazy,
                    src: new_mission_mission_user_path(@mission) do %>
  <%= icons__spinner %>
  loading...
<% end %>

<%= form_with model: @mission, local: true do |form| %>

  <div class="field mb-3">
    <%= form.label :tenant_id %>
    <%= form.text_field :tenant_id, class: "form-control" %>
  </div>
  <div class="field mb-3">
    <%= form.label :xero_webhook_key %>
    <%= form.text_field :xero_webhook_key, class: "form-control" %>
  </div>
  <div class="actions">
    <%= form.submit class: "btn btn-danger" %>
  </div>
<% end %>
