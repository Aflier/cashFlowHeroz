<% content_for :title, @mission.name %>

<%= link_to icons__edit, edit_mission_path(@mission), class: "btn-edit float-right" %>
<%= link_to raw("#{icons__plus} Transaction"),
new_mission_transaction_path(@mission),
class: "btn-edit float-right",
data: {
  turbo_frame: :remote_modal,
} %>
<h1><%= @mission.name %></h1>

<h1>Transactions</h1>
<%= paginate @transactions %>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th class="hidden sm:table-cell">Why</th>
      <th class="text-right hidden sm:table-cell">Amount (Inc. VAT)</th>
      <th class="text-right w-20">In</th>
      <th class="text-right w-20">Out</th>
      <th class="text-right hidden sm:table-cell">Business Account Balance</th>
      <th class="text-right sm:hidden">Balance</th>
      <th class="text-right hidden sm:table-cell">Cumulative Total</th>
      <th class="hidden sm:table-cell">VATable?</th>
      <th class="text-right hidden sm:table-cell">VAT</th>
    </tr>
  </thead>
  <tbody id="transactions">
    <%= render @transactions %>
  </tbody>
</table>
