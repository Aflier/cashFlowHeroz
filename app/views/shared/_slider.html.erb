<% options = {} if local_assigns[:options].nil? %>
<% direction = options[:direction] ? options[:direction] : 'left' %>
<aside
  data-controller="offcanvas"
  data-offcanvas-target="offcanvas"
  data-offcanvas-direction-value="<%= direction %>"
  data-turbo-temporary
  class="
    fixed inset-y-0 z-100 w-full sm:w-1/4 bg-white shadow-2xl border-r border-gray-200 overflow-y-auto p-2
     transform transition-transform <%= case direction
                                        when "right"
                                          "right-0 animate-drawer-right-in"
                                        else
                                          "left-0 animate-drawer-in"
                                        end %>"
>
  <div>
    <button data-action="offcanvas#close" class="float-right btn-close-sm-inline">
      <%= icons__close %>
    </button>
    <% if local_assigns[:title] %>
      <h1><%= title %></h1>
    <% end %>
  </div>
  <%= yield %>
</aside>