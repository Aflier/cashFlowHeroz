<div
  data-controller="dropdown"
  class="relative <%= local_assigns[:classes]&.to_s.presence || 'inline-block' %>"
>
  <button
    data-action="click->dropdown#toggleMenu"
    class="<%= local_assigns[:classes_inner]&.to_s.presence || 'btn-edit' %>"
  >
    <span><%= raw title %></span>
    <span class="ml-auto"><%= icons__dropdown %></span>
  </button>

  <div
    data-dropdown-target="menu"
    class="
      hidden absolute left-0 mt-2 min-w-full w-max bg-white rounded-xl border
      border-slate-200 shadow-lg p-1.5 z-50 origin-top-right transition-all flex-col
    "
  >
    <%= yield %>
  </div>

</div>
