<h1><%= @legal_entity.name %></h1>
<h2>Missions</h2>
<div class="grid grid-cols-3">
  <% @legal_entity.missions.each do |mission| %>
    <%= turbo_frame_tag mission, src: mission_card_path(mission), target: :_top %>
  <% end %>
</div>

<h4>Users</h4>
<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Role</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="mission_users">
    <%= render @legal_entity.entity_users %>
  </tbody>
</table>
