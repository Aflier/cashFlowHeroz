<% content_for :title, "Banks" %>

<div class="w-full">
  <% if notice.present? %>
    <p
      class="
        py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block
      "
      id="notice"
    ><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Banks</h1>
    <%= link_to "New bank",
    new_mission_bank_path,
    class:
      "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="banks" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @banks.any? %>
      <table>
        <tr class="w-full sm:w-auto my-5 space-y-5">
          <td>
            <strong class="block font-medium mb-1">Name:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Starting balance:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Starting balance on:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Current balance:</strong>
          </td>
          <td>
            <strong class="block font-medium mb-1">Current balance on:</strong>
          </td>
          <td class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
          </td>

        </tr>
        <%= render @banks %>
      </table>
    <% else %>
      <p class="text-center my-10">No banks found.</p>
    <% end %>
  </div>
</div>
