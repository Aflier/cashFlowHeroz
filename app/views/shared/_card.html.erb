<% classes = local_assigns[:classes] || "" %>
<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col <%= classes %>">
  <% if local_assigns[:header] %>
    <div class="px-5 py-2 border-b border-slate-200 bg-slate-50">
      <%= header %>
    </div>
  <% end %>

  <div class="p-5">
    <%= yield %>
  </div>

  <% if local_assigns[:footer] %>
    <div class="px-5 py-2 border-t border-slate-200 bg-slate-50 flex  gap-3">
      <%= footer %>
    </div>
  <% end %>
</div>