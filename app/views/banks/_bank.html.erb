<tr id="<%= dom_id bank %>" class="w-full sm:w-auto my-5 space-y-5">
  <td>
    <%= link_to bank.name, bank %>
  </td>
  <td>
    <%= bank.starting_balance %>
  </td>
  <td>
    <%= bank.starting_balance_on %>
  </td>
  <td>
    <%= bank.current_balance %>
  </td>
  <td>
    <%= bank.current_balance_on %>
  </td>
  <td class="space-y-2 text-right ">
    <%= link_to icons__edit, edit_bank_path(bank), class: "btn-edit" %>
    <%= button_to icons__trash,
    bank,
    method: :delete,
    class: "btn-destroy-sm",
    data: {
      turbo_confirm: "Are you sure?",
    } %>
  </td>

</tr>
